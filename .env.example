# Copy to .env.local and fill in. Only NEXT_PUBLIC_ values reach the browser.

# Supabase -> Project Settings -> API. Used for sign-in only; all data goes through the backend.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the Localty backend (the backend/ folder) is running.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server only, never NEXT_PUBLIC. The same value as the backend's INTERNAL_API_KEY. Pages rendered on this
# server call the backend for many visitors from one address; with the key they pass each visitor's address,
# so the backend's rate limits apply per visitor instead of to the whole site at once.
INTERNAL_API_KEY=
# Optional. The header your host fills with the visitor's address. Default: x-real-ip on Vercel,
# cf-connecting-ip elsewhere (Render).
CLIENT_IP_HEADER=

# Optional. Without it the live delivery map is replaced by an "Open in Google Maps" link.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Show "Mobile OTP" on the sign-in page. It sends an SMS, so only turn it on once Supabase has an SMS provider.
NEXT_PUBLIC_PHONE_LOGIN=false

# Optional. Shown at the bottom of the terms, privacy and refunds pages.
NEXT_PUBLIC_SUPPORT_EMAIL=
