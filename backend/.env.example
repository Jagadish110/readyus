# Copy to .env and fill in. This file is only ever read by the payments service,
# never by the Next.js app and never by the browser.

NODE_ENV=development
PORT=4000
# 127.0.0.1 keeps it local. Use 0.0.0.0 inside a container.
HOST=127.0.0.1
# true only when a trusted proxy (Render, Fly, nginx) is in front of the service.
TRUST_PROXY=false
# Browser origins allowed to call this API, comma separated. Production: your real site.
ALLOWED_ORIGINS=http://localhost:3000

# Supabase → Project Settings → API. The service_role key bypasses row level security.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → "Transaction pooler" connection string (includes your database password).
# Orders, checkout and addresses are unavailable until this is set.
DATABASE_URL=

# Cashfree → Developers → API keys. Use CASHFREE_ENV=sandbox until you go live.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional: where Cashfree sends the customer after a redirect-style payment.
CASHFREE_RETURN_URL=
# Webhooks (Developers → Webhooks) are signed with CASHFREE_SECRET_KEY.
# URL: https://YOUR-API/v1/webhooks/cashfree, event PAYMENT_SUCCESS_WEBHOOK.

# Authorises the refund sweep: POST /internal/refunds/sweep with this as a Bearer token.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
