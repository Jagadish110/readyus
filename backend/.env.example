# Copy to .env and fill in. This file is only ever read by the payments service,
# never by the Next.js app and never by the browser.

NODE_ENV=development
PORT=4000
# 127.0.0.1 keeps it local. Use 0.0.0.0 inside a container.
HOST=127.0.0.1
# true only when a trusted proxy (Render, Fly, nginx) is in front of the service.
TRUST_PROXY=false
# Optional. A header your host's edge sets to the visitor's address and that callers cannot fake, used
# for rate limits. On Render (behind Cloudflare): cf-connecting-ip. Leave empty on a laptop.
CLIENT_IP_HEADER=
# Browser origins allowed to call this API, comma separated. Production: your real site.
ALLOWED_ORIGINS=http://localhost:3000

# Supabase → Project Settings → API. The service_role key bypasses row level security.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → "Transaction pooler" connection string (includes your database password).
# Orders, checkout and addresses are unavailable until this is set.
DATABASE_URL=
# Optional. Connections each running copy of this server keeps to the pooler (default 10). The pooler
# shares a fixed number of real connections between all clients: raise it with the database plan.
DATABASE_POOL_MAX=10
# Optional, recommended in production. Supabase → Database settings → SSL configuration → download the
# certificate and paste its text here, so the database's certificate is verified, not only encrypted.
DATABASE_CA_CERT=

# Cashfree → Developers → API Keys. Use the SANDBOX (test) keys until you go live: with
# CASHFREE_ENV=sandbox the secret must be a test key, with production a live key; a mix-up
# stops the server at start-up. The same secret key also signs webhooks.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Optional. The Cashfree API version to call.
CASHFREE_API_VERSION=2025-01-01
# Cashfree can check a shop's bank account when it is saved (Cashfree charges for each check).
CASHFREE_VERIFY_VENDOR_BANK=true

# This server's public https address, sent to Cashfree as the webhook address for each order.
# Leave empty on a laptop; set it in production, e.g. https://api.localty.in
PUBLIC_API_URL=
# The website. Cashfree sends customers back here after paying.
SITE_URL=http://localhost:3000

# Browser notifications (Web Push). Make a pair once with `npm run vapid`, keep the private key secret.
# Without these the in-app bell still works; only the pop-up alerts on phones and desktops are off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the browser vendors can use if your pushes misbehave.
VAPID_SUBJECT=mailto:you@yourdomain.com

# Shared with the website's server: set the same value there (not NEXT_PUBLIC). Pages that server renders
# call this API for many visitors from one address; with the key each visitor gets their own rate limit
# instead of the whole site sharing one. Generate it like CRON_SECRET below.
INTERNAL_API_KEY=

# Authorises the refund sweep: POST /internal/refunds/sweep with this as a Bearer token.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
